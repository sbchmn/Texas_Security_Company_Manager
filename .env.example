DEBUG=true
SECRET_KEY=replace-with-at-least-50-random-characters
ALLOWED_HOSTS=localhost,127.0.0.1
# Trust X-Forwarded-Proto only behind a TLS-terminating proxy that overwrites client
# values (compose Caddy and App Platform both set this for the web service themselves).
TRUST_PROXY_SSL_HEADER=
# Host name Caddy serves HTTPS on; a public domain gets a Let's Encrypt certificate,
# a LAN host name or IP address gets one from Caddy's internal CA.
TSCM_SITE_ADDRESS=localhost
# Host ports Caddy publishes; raise these if 80/443 are taken by other stacks.
TSCM_HTTP_PORT=80
TSCM_HTTPS_PORT=443
MYSQL_DATABASE=tscm
MYSQL_USER=tscm
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=change-this-password
BOOTSTRAP_COMPANY=Lone Star Security
BOOTSTRAP_SLUG=lone-star-security
MALWARE_SCAN_MODE=basic
# Production must use MALWARE_SCAN_MODE=clamav and provide CLAMAV_HOST.
CLAMAV_HOST=
CLAMAV_PORT=3310
REDIS_URL=redis://cache:6379/0
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DEFAULT_FROM_EMAIL=alerts@example.com
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
POSTMARK_SERVER_TOKEN=
AWS_REGION=us-east-1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_CLIENT_ID=
MICROSOFT_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_TENANT=common
