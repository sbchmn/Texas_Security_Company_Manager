# Copy to .env and replace every secret before exposing this app to a network.
#
# DEBUG=true is for working on the code only: it disables HSTS, secure cookies, and the
# HTTPS redirect, and it allows the unsafe development SECRET_KEY below. Leave it false for
# anything another machine can reach. Compose reads this file for the web and worker
# services, so a stale DEBUG=true here is a production misconfiguration, not a local one.
DEBUG=false
SECRET_KEY=replace-with-at-least-50-random-characters
# Must contain the hostname Caddy serves (TSCM_SITE_ADDRESS) and every verified custom
# domain, or every request is rejected as an unknown host.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# The address officers' phones open from a text message, e.g. https://tscm.example.com or
# https://10.12.1.40:8443. A company's verified custom domain is used first when it has one;
# leave this empty and texts are sent without a link.
PUBLIC_BASE_URL=
TIME_ZONE=America/Chicago
# Trust X-Forwarded-Proto only behind a TLS-terminating proxy that overwrites client
# values (compose Caddy and App Platform both set this for the web service themselves).
TRUST_PROXY_SSL_HEADER=
# Peer CIDRs allowed to supply X-Forwarded-For. Compose sets a docker-network default for
# web/worker; a public deployment behind any other proxy must set this, or every visitor
# shares a single login-throttle bucket. Leave empty when nothing proxies to the app.
TRUSTED_PROXIES=
# Source ranges allowed to reach /admin/. Empty with DEBUG=false closes the admin to every
# address; never leave it open on a public host.
ADMIN_ALLOWED_IPS=
SECURE_HSTS_SECONDS=31536000
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=900
# Host name Caddy serves HTTPS on; a public domain gets a Let's Encrypt certificate,
# a LAN host name gets one from Caddy's internal CA. Several addresses may be listed
# comma-separated, and ALLOWED_HOSTS must name the same set.
#
# Two traps, both of which cost real debugging time:
#  1. A bare IP address cannot be the only site address. TLS clients send SNI for host names
#     but not for IP literals (RFC 6066), so Caddy cannot pick a certificate for
#     https://10.12.1.40:8443 and the handshake aborts with "internal error". Browse by a
#     name instead: "10.12.1.40, localhost", or a LAN DNS name / hosts entry.
#  2. A variable that is ALSO exported in your shell or as a Windows system/user environment
#     variable wins over this file - in compose's ${VAR} interpolation, and in Django, because
#     load_dotenv never overwrites a value already present in the environment. Edit .env and
#     see nothing change? Check: docker compose -f compose.yaml config | findstr TSCM
TSCM_SITE_ADDRESS=localhost
# Host ports Caddy publishes; raise these if 80/443 are taken by other stacks.
TSCM_HTTP_PORT=80
TSCM_HTTPS_PORT=443
# The hostname DocuSeal is served on, once the signing profile is started:
#   docker compose -f compose.yaml --profile signing up -d
# It is a second Caddy site block on the same listener, NOT a path under the first: DocuSeal has
# no relative-url-root setting, so proxying app.example.com/sign with the prefix stripped makes it
# generate asset, redirect and download URLs that leave the prefix out. The default is a name that
# resolves nowhere, so the block costs nothing and shadows nothing until signing is enabled. A
# real deployment needs a DNS record for it; Caddy requests a certificate for it exactly as it does
# for TSCM_SITE_ADDRESS, which means a bare IP cannot be used here either (see the SNI note above).
# Do NOT add this name to ALLOWED_HOSTS or CSRF_TRUSTED_ORIGINS: Django never serves it, and the
# browser talks to DocuSeal directly, so there is no cross-origin form post to authorise.
# docs/development-roadmap.md §13 records the rest of the signing picture, including what is
# Pro-only and why the community edition is one account per installation.
TSCM_SIGN_ADDRESS=sign.localhost
# Optional Caddy overrides, each a full directive line. Uncomment for a private CA on a
# publicly resolvable name, or to register an ACME account contact address.
# CADDY_TLS_MODE=tls internal
# CADDY_ACME_EMAIL_LINE=email ops@example.com
# Leave MYSQL_DATABASE empty to run on the bundled SQLite file (local development only).
# db/3306 is the bundled MySQL container, started by the local-db profile below. For a managed
# database put its host and port here (DigitalOcean: port 25060) and remove local-db.
# A --profile flag on the command line replaces this list rather than adding to it, so list every
# profile you use here (e.g. local-db,signing) and run plain `docker compose up -d`.
COMPOSE_PROFILES=local-db
MYSQL_HOST=db
MYSQL_PORT=3306
# Keep a MySQL connection open between requests for this many seconds. Leave it at 60 unless
# every worker also sees the DB latency; test runs ignore it (a test wraps each case in a
# transaction, and an expiring connection would be closed inside it).
CONN_MAX_AGE=60
MYSQL_DATABASE=tscm
MYSQL_USER=tscm
MYSQL_PASSWORD=change-me
# TLS to MySQL. Leave all four unset for the bundled database: the driver then encrypts whenever
# the server offers TLS but accepts any certificate. For a managed database (DigitalOcean managed
# MySQL requires TLS) give its CA certificate so the server is verified: the file path in
# MYSQL_SSL_CA, or the certificate text in MYSQL_SSL_CA_PEM (\n escapes are accepted).
# MYSQL_SSL_MODE is disabled | preferred | required | verify_ca | verify_identity; with a CA it
# defaults to verify_identity, which also checks the certificate names MYSQL_HOST (fall back to
# verify_ca if the provider's certificate does not). For DigitalOcean use MYSQL_PORT=25060 and the
# host shown in the cluster's connection details.
# MYSQL_SSL_CA=/run/secrets/mysql-ca.crt
# MYSQL_SSL_CA_PEM=
# MYSQL_SSL_CA_DIR=
# MYSQL_SSL_MODE=verify_identity
MYSQL_ROOT_PASSWORD=change-root-me
# Root is created with this host at first initialisation only; % is a development default.
MYSQL_ROOT_HOST=%
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=change-this-password
BOOTSTRAP_COMPANY=Lone Star Security
BOOTSTRAP_SLUG=lone-star-security
# 1 runs "manage.py bootstrap_admin" at container start; use it for the first deploy on a
# platform without a shell, then set it back to 0.
RUN_BOOTSTRAP=0
# 1 runs "manage.py check --deploy --fail-level WARNING" before serving traffic.
DJANGO_CHECK_DEPLOY=0
MALWARE_SCAN_MODE=basic
# Production must use MALWARE_SCAN_MODE=clamav and provide CLAMAV_HOST; with no scanner
# reachable, every document upload fails closed.
CLAMAV_HOST=
CLAMAV_PORT=3310
REDIS_URL=redis://cache:6379/0
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=120
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DEFAULT_FROM_EMAIL=alerts@example.com
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
POSTMARK_SERVER_TOKEN=
AWS_REGION=us-east-1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_CLIENT_ID=
MICROSOFT_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_TENANT=common
# ── Document signing (DocuSeal community edition) ────────────────────────────────
# Nothing here is read until the signing profile is started:
#   docker compose -f compose.yaml --profile signing up -d
# which adds docuseal plus its own queue backend and gives DocuSeal a database of its own inside
# the MySQL server above. TSCM_SIGN_ADDRESS is the name it is served on. The reasoning, the
# Pro/community boundary, and what is still unbuilt are in docs/development-roadmap.md §13.
#
# Everything below is safe to leave empty, because compose.yaml supplies the default shown. The
# values that must be ABSENT rather than blank are not here — see docuseal.env at the end of this
# section. DocuSeal reads its config with plain Ruby truthiness and ENV.fetch(name, default).to_i,
# so an empty string is a value (a host of "", zero job threads), not an absence.
DOCUSEAL_IMAGE=docuseal/docuseal:3.3.0
# Exact trusted HTTPS origin(s) for the application-side API and signed PDF downloads.
# Configure the same origin and a tenant's API key at /settings/signing/.
# Empty disables new signing connections. No arbitrary tenant-entered outbound destination.
DOCUSEAL_ALLOWED_ORIGINS=
# Optional CA certificate trusted ONLY for DocuSeal API/file requests. Leave empty when DocuSeal
# has a publicly trusted certificate. For local testing with Caddy's private CA and the default
# 8443 host port:
#   DOCUSEAL_ALLOWED_ORIGINS=https://sign.localhost:8443
#   DOCUSEAL_CA_BUNDLE=/app/certs/caddy-local-root.crt
# Start the signing profile and open https://sign.localhost:8443 once so Caddy creates its local CA,
# copy only its public root certificate, then recreate web and worker:
#   docker compose -f compose.yaml cp caddy:/data/caddy/pki/authorities/local/root.crt certs/caddy-local-root.crt
#   docker compose -f compose.yaml up -d --no-deps --force-recreate web worker
# Never copy Caddy's root.key or disable TLS verification. compose.yaml mounts ./certs read-only.
# Set DocuSeal's Settings > Account > App URL to the same origin. A phone cannot open sign.localhost.
DOCUSEAL_CA_BUNDLE=
# DocuSeal's database and user inside the shared MySQL server — its own schema, with no grant on
# the application's tables. docker/mysql-init-signing.sh creates them on the first boot of an
# empty data directory; on an installation that already has one, apply the same statements by hand
# once, then start the profile:
#   docker compose -f compose.yaml exec db mysql -uroot -p
# Forgetting it does not fail cleanly: with no such account DocuSeal crash-loops on
#   trilogy_auth_recv: TRILOGY_PROTOCOL_VIOLATION
# which looks like a TLS or auth-plugin fault and is really a missing user. Check the account
# before believing the error message.
DOCUSEAL_DB_NAME=docuseal
DOCUSEAL_DB_USER=docuseal
DOCUSEAL_DB_PASSWORD=change-me
# Leave empty to use the shared MySQL server. Set it to replace the whole connection string, e.g.
# postgresql://user:pass@host:5432/docuseal — the image ships the pg, sqlite3 and trilogy gems, so
# both engines work; a password inside a URL like this one also has to be URL-encoded.
# Required when the local-db profile is off, because the default points at db. For managed MySQL:
#   DOCUSEAL_DATABASE_URL=mysql2://docuseal:PASSWORD@your-cluster-host:25060/docuseal?ssl_mode=required
DOCUSEAL_DATABASE_URL=
# Rails force_ssl + assume_ssl. Keep true behind Caddy, which terminates TLS and forwards
# X-Forwarded-Proto. Set false only for a direct http://host:3000 test, and then the signing links
# DocuSeal hands out are http links.
DOCUSEAL_FORCE_SSL=true
# Puma workers. 0 is one threaded process, and that process carries DocuSeal's queue processor
# (config/puma.rb embeds Sidekiq in it); every worker you add forks another, so this is not the
# same kind of knob as WEB_CONCURRENCY for gunicorn even though the name is shared — which is why
# compose.yaml maps the two separately instead of passing one .env to both containers.
DOCUSEAL_WEB_CONCURRENCY=0
DOCUSEAL_SIDEKIQ_THREADS=5
# DocuSeal console sessions, not signing sessions: an officer follows a tokenised link and never
# logs in here. Upstream defaults this to 730 days.
DOCUSEAL_SESSION_REMEMBER_DAYS=7
# How long a signed-PDF link stays fetchable. These are the windows that matter when somebody asks
# for a document a week later: after they pass the file is still in storage, but the URL in an old
# email no longer opens it.
DOCUSEAL_PRESIGNED_URLS_EXPIRE_MINUTES=240
DOCUSEAL_FILE_URLS_EXPIRE_MINUTES=40
# Leave the storage block empty to keep signed documents on the docuseal_data volume. If you use
# object storage, give DocuSeal its own bucket: the retention clock on a signed document is not the
# retention clock on a personnel file, and one bucket cannot answer two disposal rules.
DOCUSEAL_S3_ATTACHMENTS_BUCKET=
DOCUSEAL_S3_ENDPOINT=
DOCUSEAL_AWS_ACCESS_KEY_ID=
DOCUSEAL_AWS_SECRET_ACCESS_KEY=
DOCUSEAL_AWS_REGION=
# Values DocuSeal must be able to leave UNSET belong in docuseal.env, a file next to compose.yaml
# that the service reads if it exists and ignores if it does not. Write only the lines you need:
#   SECRET_KEY_BASE=<output of: openssl rand -hex 64>
#     Unset, DocuSeal generates its own key into the docuseal_data volume on first boot. Keep that
#     file in the backup set either way: it derives the encryption keys for whatever DocuSeal
#     stores in its own database, so a dump restored without it cannot read them.
#   SMTP_ADDRESS=<host>  SMTP_PORT  SMTP_DOMAIN  SMTP_USERNAME  SMTP_PASSWORD
#   SMTP_AUTHENTICATION  SMTP_FROM
#     DocuSeal speaks SMTP only and cannot use the Mailjet/Postmark API keys this application
#     already holds. The plan in §13 is that this application sends the invitation carrying the
#     signing link and DocuSeal stays a signing backend, so this block stays absent.
#   HOST=<the signing hostname>
#     Only needed if DocuSeal is allowed to mail directly; links it builds during a request already
#     follow the Host header Caddy forwards.
#   GOTENBERG_URL=<gotenberg service>
#     DOCX/HTML conversion, and a Pro feature. A blank value would be read as configured.
# Recovery: compose --profile backups starts these. See docs/backup-and-restore.md.
BACKUP_INTERVAL_SECONDS=3600
BACKUP_KEEP=72
MYSQL_BACKUP_USER=root
MYSQL_BACKUP_PASSWORD=
# mysqldump names its databases, so sharing the MySQL server does NOT put DocuSeal's signatures in
# the backup set by itself. Set this to the signing database once it exists (check with
# docker compose -f compose.yaml exec db mysql -uroot -p -e "SHOW DATABASES") — naming a database
# that is not there makes every dump fail, which is why it ships empty. If MYSQL_BACKUP_USER is not
# root, it needs a grant on this database too.
DOCUSEAL_BACKUP_DATABASES=
