# Docker sends the working tree as the build context, so a checkout that is normalised to
# CRLF would bake a "\r" into the shell shebang and the container would fail to start.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
Caddyfile text eol=lf
.env.example text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf
*.png binary
*.svg text eol=lf
