.env
# Any sidecar env file, e.g. docuseal.env next to compose.yaml: it holds the signing container's
# SECRET_KEY_BASE and SMTP credentials, which are exactly as secret as .env. .env.example stays
# tracked on purpose — it is the template, and it contains no real values.
*.env
.venv/
__pycache__/
*.py[cod]
db.sqlite3
media/
staticfiles/
.pytest_cache/
.DS_Store
artifacts/
node_modules/
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/local.properties
mobile/android/generated/
mobile/ios/*.xcodeproj/
mobile/ios/build/
*.xcuserstate
*.keystore
*.jks
*.p12
*.mobileprovision
*.apk
*.aab
*.ipa
*.xcarchive/
# Scratch space for one-off probes and diagnostic scripts while a session is working. The harnesses that
# earned a permanent home live in scripts/verification/ instead; anything still here is disposable, and
# a probe that has been copied into the repo tends to carry a throwaway container's password in it.
.qwen/tmp/
.qwen/worktrees/

# Local trust anchors for development, such as Caddy's public root certificate.
certs/*
!certs/.gitkeep
